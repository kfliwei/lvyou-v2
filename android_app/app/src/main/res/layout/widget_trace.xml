<?xml version="1.0" encoding="utf-8"?>
<!-- 行迹卡片 4x2：印章 + 三格统计 + 最近记忆 + 随手记直达（RemoteViews 兼容控件） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/w_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/widget_bg"
  android:padding="14dp">

  <!-- 顶栏：印章 / 名称 / 日期 -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <TextView
      android:layout_width="38dp"
      android:layout_height="38dp"
      android:background="@drawable/widget_seal"
      android:gravity="center"
      android:text="行"
      android:textColor="#FFF7F5EF"
      android:textSize="19sp"
      android:textStyle="bold"/>
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:orientation="vertical">
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="行迹 TRACE"
        android:textColor="@color/ink_900"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"/>
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="把世界走成回忆"
        android:textColor="@color/ink_400"
        android:textSize="10sp"/>
    </LinearLayout>
    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:gravity="end">
      <TextView
        android:id="@+id/w_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ink_900"
        android:textSize="13sp"
        android:textStyle="bold"/>
      <TextView
        android:id="@+id/w_week"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/ink_400"
        android:textSize="10sp"/>
    </LinearLayout>
  </LinearLayout>

  <!-- 统计行：城市 / 记录 / 心愿 -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <LinearLayout
      android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
      android:orientation="vertical" android:gravity="center">
      <TextView android:id="@+id/w_cities" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/cinnabar" android:textSize="20sp" android:textStyle="bold" android:text="0"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp"
        android:textColor="@color/ink_400" android:textSize="10sp" android:text="走过的城市"/>
    </LinearLayout>
    <View android:layout_width="1dp" android:layout_height="30dp" android:background="@color/gold_hairline"/>
    <LinearLayout
      android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
      android:orientation="vertical" android:gravity="center">
      <TextView android:id="@+id/w_notes" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/cinnabar" android:textSize="20sp" android:textStyle="bold" android:text="0"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp"
        android:textColor="@color/ink_400" android:textSize="10sp" android:text="留下的记录"/>
    </LinearLayout>
    <View android:layout_width="1dp" android:layout_height="30dp" android:background="@color/gold_hairline"/>
    <LinearLayout
      android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
      android:orientation="vertical" android:gravity="center">
      <TextView android:id="@+id/w_wishes" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/cinnabar" android:textSize="20sp" android:textStyle="bold" android:text="0"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp"
        android:textColor="@color/ink_400" android:textSize="10sp" android:text="待圆的心愿"/>
    </LinearLayout>
  </LinearLayout>

  <!-- 记忆行：最近一撇 + 随手记按钮 -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="12dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <View android:layout_width="3dp" android:layout_height="34dp" android:background="@color/cinnabar"/>
    <LinearLayout
      android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
      android:layout_marginStart="9dp"
      android:orientation="vertical">
      <TextView android:id="@+id/w_place" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/ink_900" android:textSize="12sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" android:text="还没有足迹"/>
      <TextView android:id="@+id/w_quote" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/ink_600" android:textSize="11sp"
        android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="2dp"
        android:text="打开行迹，记下第一段旅程"/>
    </LinearLayout>
    <TextView android:id="@+id/w_note" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:background="@drawable/widget_pill"
      android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="9dp" android:paddingBottom="9dp"
      android:text="＋ 随手记" android:textColor="#FFF7F5EF" android:textSize="12sp"/>
  </LinearLayout>
</LinearLayout>
